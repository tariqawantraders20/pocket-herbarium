<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketHerbarium" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/herb_green_primary</item>
        <item name="colorOnPrimary">@color/herb_paper</item>
        <item name="colorPrimaryContainer">@color/herb_green_soft</item>
        <item name="colorOnPrimaryContainer">@color/herb_ink</item>
        <item name="colorSecondary">@color/herb_marker</item>
        <item name="colorOnSecondary">@color/herb_ink</item>
        <item name="colorSecondaryContainer">@color/herb_paper_tint</item>
        <item name="colorOnSecondaryContainer">@color/herb_ink</item>
        <item name="colorSurface">@color/herb_paper_card</item>
        <item name="colorOnSurface">@color/herb_ink</item>
        <item name="colorSurfaceVariant">@color/herb_paper_tint</item>
        <item name="colorOnSurfaceVariant">@color/herb_ink_soft</item>
        <item name="colorOutline">@color/herb_hairline</item>
        <item name="colorError">@color/herb_terracotta</item>
        <item name="colorOnError">@color/herb_paper</item>
        <item name="android:colorBackground">@color/herb_paper</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/herb_green_forest</item>
        <item name="android:navigationBarColor">@color/herb_green_forest</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PocketHerbarium.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="colorPrimary">@color/herb_green_primary</item>
        <item name="colorOnPrimary">@color/herb_paper</item>
        <item name="colorSurface">@color/herb_paper_card</item>
        <item name="colorOnSurface">@color/herb_ink</item>
        <item name="colorSecondary">@color/herb_marker</item>
    </style>
</resources>
