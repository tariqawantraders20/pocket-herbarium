<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/herb_ink</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/herb_ink</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/herb_ink</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/herb_ink_soft</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/herb_ink_muted</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/herb_ink_muted</item>
    </style>

    <style name="TextAppearance.App.LabelWide" parent="TextAppearance.App.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.2</item>
    </style>

    <style name="TextAppearance.App.Numeric" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/herb_ink</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.App.ButtonSmall" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/herb_paper</item>
        <item name="backgroundTint">@color/herb_green_primary</item>
        <item name="rippleColor">@color/herb_ripple_marker</item>
        <item name="cornerRadius">@dimen/cta_radius</item>
        <item name="iconTint">@color/herb_paper</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="android:minHeight">@dimen/cta_height</item>
        <item name="android:elevation">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonSmall</item>
        <item name="android:textColor">@color/herb_ink_soft</item>
        <item name="strokeColor">@color/herb_hairline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="rippleColor">@color/herb_ripple_marker</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
        <item name="android:minHeight">@dimen/secondary_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonSmall</item>
        <item name="android:textColor">@color/herb_terracotta</item>
        <item name="strokeColor">@color/herb_hairline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="rippleColor">@color/herb_ripple_marker</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
        <item name="android:minHeight">@dimen/secondary_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.DangerFilled" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonSmall</item>
        <item name="android:textColor">@color/herb_paper</item>
        <item name="backgroundTint">@color/herb_terracotta</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
        <item name="android:minHeight">@dimen/secondary_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonSmall</item>
        <item name="android:textColor">@color/herb_ink_soft</item>
        <item name="android:minHeight">@dimen/secondary_height</item>
        <item name="rippleColor">@color/herb_ripple_marker</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/herb_ink_soft</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="rippleColor">@color/herb_ripple_marker</item>
    </style>

    <style name="Widget.App.Button.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonSmall</item>
        <item name="android:textColor">@color/sel_chip_text</item>
        <item name="backgroundTint">@color/sel_chip_background</item>
        <item name="strokeColor">@color/sel_chip_stroke</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
        <item name="rippleColor">@color/herb_ripple_marker</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/herb_paper_card</item>
        <item name="strokeColor">@color/herb_hairline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/herb_green_primary</item>
        <item name="boxStrokeWidth">@dimen/hairline</item>
        <item name="hintTextColor">@color/herb_ink_muted</item>
        <item name="android:textColorHint">@color/herb_ink_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_radius_small</item>
        <item name="startIconTint">@color/herb_green_primary</item>
    </style>
</resources>
