<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/herb_paper">

    <ImageView
        android:id="@+id/menu_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wash_paper"
        android:importantForAccessibility="no" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingBottom="@dimen/root_bottom_pad">

        <TextView
            android:id="@+id/menu_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.2"
            android:text="@string/menu_eyebrow"
            android:textAppearance="@style/TextAppearance.App.LabelWide"
            app:layout_constraintBottom_toBottomOf="@id/menu_settings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/menu_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_settings"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/cd_settings"
            app:icon="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/menu_title_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="18dp"
            android:text="@string/menu_title_top"
            android:textAppearance="@style/TextAppearance.App.Display"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_settings" />

        <TextView
            android:id="@+id/menu_title_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:lineSpacingExtra="2dp"
            android:text="@string/menu_title_bottom"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textColor="@color/herb_green_deep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_title_top" />

        <View
            android:id="@+id/menu_rule"
            android:layout_width="@dimen/rule_width"
            android:layout_height="@dimen/hairline"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="16dp"
            android:background="@color/herb_hairline"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_title_bottom" />

        <TextView
            android:id="@+id/menu_tagline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="14dp"
            android:maxWidth="260dp"
            android:text="@string/menu_tagline"
            android:textAppearance="@style/TextAppearance.App.Body"
            app:layout_constraintEnd_toStartOf="@id/menu_hero_art"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_rule"
            app:layout_constraintWidth_max="260dp" />

        <ImageView
            android:id="@+id/menu_hero_art"
            android:layout_width="@dimen/hero_art"
            android:layout_height="@dimen/hero_art"
            android:layout_marginEnd="4dp"
            android:alpha="0.92"
            android:contentDescription="@string/cd_hero_art"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_fern_frond"
            app:layout_constraintBottom_toTopOf="@id/menu_stats_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_rule"
            app:layout_constraintVertical_bias="0.45" />

        <LinearLayout
            android:id="@+id/menu_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/banner_warning"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_tagline">

            <ImageView
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:contentDescription="@string/cd_warning"
                android:src="@drawable/ic_warning" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/menu_error_banner"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_stats_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/section_gap"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/menu_strip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.pocketherbarium.notes.core.ui.StatCardView
                android:id="@+id/menu_stat_specimens"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                app:statAccent="@color/herb_green_primary"
                app:statLabel="@string/stat_specimens"
                app:statValue="0" />

            <com.pocketherbarium.notes.core.ui.StatCardView
                android:id="@+id/menu_stat_collections"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                app:statAccent="@color/herb_marker"
                app:statLabel="@string/stat_collections"
                app:statValue="0" />

            <com.pocketherbarium.notes.core.ui.StatCardView
                android:id="@+id/menu_stat_last"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                app:statAccent="@color/herb_terracotta"
                app:statLabel="@string/stat_last_entry"
                app:statValue="0" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/menu_strip"
            android:layout_width="0dp"
            android:layout_height="@dimen/specimen_strip_height"
            android:layout_marginBottom="@dimen/section_gap"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            app:layout_constraintBottom_toTopOf="@id/menu_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/menu_skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/specimen_strip_height"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/section_gap"
            android:importantForAccessibility="no"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/menu_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="@dimen/specimen_card_width"
                android:layout_height="match_parent"
                android:background="@drawable/skeleton_paper" />

            <View
                android:layout_width="@dimen/specimen_card_width"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@drawable/skeleton_paper" />

            <View
                android:layout_width="@dimen/specimen_card_width"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@drawable/skeleton_paper" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_empty"
            android:layout_width="0dp"
            android:layout_height="@dimen/specimen_strip_height"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/outline_dashed_paper"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/menu_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_empty_title"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/herb_green_deep"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_empty_body"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/menu_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginBottom="@dimen/block_gap"
            android:letterSpacing="0.1"
            android:text="@string/menu_hint"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/menu_cta"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_cta"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/cta_height"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/cta_bottom_gap"
            android:text="@string/menu_cta"
            app:icon="@drawable/ic_leaf_add"
            app:layout_constraintBottom_toTopOf="@id/menu_secondary_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/menu_secondary_row"
            android:layout_width="0dp"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu_collections"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_collections"
                app:icon="@drawable/ic_collection"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="@dimen/icon_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu_reset"
                style="@style/Widget.App.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/btn_reset" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
