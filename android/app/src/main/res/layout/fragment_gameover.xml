<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/herb_paper">

    <ImageView
        android:id="@+id/result_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wash_paper_strong"
        android:importantForAccessibility="no" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingBottom="@dimen/root_bottom_pad">

        <TextView
            android:id="@+id/result_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cta_bottom_gap"
            android:letterSpacing="0.2"
            android:text="@string/result_header"
            android:textAppearance="@style/TextAppearance.App.LabelWide"
            android:textColor="@color/herb_green_deep"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/result_rule"
            android:layout_width="@dimen/rule_width_small"
            android:layout_height="@dimen/hairline"
            android:layout_marginTop="10dp"
            android:background="@color/herb_hairline"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result_header" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/result_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/result_stats_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result_rule">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="@dimen/section_gap"
                android:paddingEnd="12dp"
                android:paddingBottom="@dimen/section_gap">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/result_plate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/herb_paper_card"
                    app:cardCornerRadius="@dimen/plate_radius"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/herb_hairline"
                    app:strokeWidth="@dimen/hairline">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/gutter"
                        android:paddingTop="@dimen/gutter"
                        android:paddingEnd="@dimen/gutter"
                        android:paddingBottom="@dimen/gutter">

                        <View
                            android:id="@+id/result_marker"
                            android:layout_width="6dp"
                            android:layout_height="40dp"
                            android:background="@drawable/marker_ribbon"
                            android:importantForAccessibility="no" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/plate_grid"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/result_sprite"
                                android:layout_width="@dimen/plate_sprite"
                                android:layout_height="@dimen/plate_sprite"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_plate"
                                android:scaleType="fitCenter"
                                android:src="@drawable/sprite_leaf_oval" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/result_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/section_gap"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/default_specimen_name"
                            android:textAppearance="@style/TextAppearance.App.Headline" />

                        <TextView
                            android:id="@+id/result_latin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/default_latin_name"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/hairline"
                            android:layout_marginTop="@dimen/section_gap"
                            android:background="@color/herb_hairline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/block_gap"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_row_shape"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/result_value_shape"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/trait_oval"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/herb_ink"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_row_colour"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/result_value_colour"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/colour_sage"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/herb_ink"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_row_habitat"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/result_value_habitat"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/habitat_woodland"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/herb_ink"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/block_gap"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:contentDescription="@string/cd_care_icon"
                                android:src="@drawable/ic_watering" />

                            <TextView
                                android:id="@+id/result_care_note"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:maxLines="3"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/result_stats_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/section_gap"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/result_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.pocketherbarium.notes.core.ui.StatCardView
                android:id="@+id/result_stat_library"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                app:statAccent="@color/herb_green_primary"
                app:statLabel="@string/stat_in_library"
                app:statValue="0" />

            <com.pocketherbarium.notes.core.ui.StatCardView
                android:id="@+id/result_stat_collection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                app:statAccent="@color/herb_marker"
                app:statLabel="@string/stat_in_collection"
                app:statValue="0" />

        </LinearLayout>

        <TextView
            android:id="@+id/result_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/block_gap"
            android:letterSpacing="0.1"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/result_cta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_cta"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/cta_height"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/cta_bottom_gap"
            android:text="@string/result_cta"
            app:icon="@drawable/ic_leaf_add"
            app:layout_constraintBottom_toTopOf="@id/result_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_menu"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:text="@string/btn_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
