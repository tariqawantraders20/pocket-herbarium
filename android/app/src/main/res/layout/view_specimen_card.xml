<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/specimen_thumb"
            android:layout_width="@dimen/thumb_size"
            android:layout_height="@dimen/thumb_size"
            android:contentDescription="@string/cd_specimen_thumb"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_leaf_oval" />

        <TextView
            android:id="@+id/specimen_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/specimen_latin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textSize="11sp" />

    </LinearLayout>

    <View
        android:id="@+id/specimen_marker"
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/marker_ribbon"
        android:importantForAccessibility="no" />

</merge>
