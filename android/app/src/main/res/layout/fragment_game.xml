<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/herb_paper">

    <ImageView
        android:id="@+id/game_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wash_paper"
        android:importantForAccessibility="no" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:id="@+id/game_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="@dimen/status_bar_pad"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_back"
                style="@style/Widget.App.Button.Icon"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/cd_back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/game_header"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/herb_ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/step_pill"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/game_step"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/herb_green_deep" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/game_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/game_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/section_gap"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/section_gap">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/game_preview_card"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/preview_card_height"
                    android:accessibilityLiveRegion="polite">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/game_preview_sprite"
                            android:layout_width="@dimen/preview_sprite"
                            android:layout_height="@dimen/preview_sprite"
                            android:contentDescription="@string/cd_preview"
                            android:scaleType="fitCenter"
                            android:src="@drawable/sprite_leaf_oval" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/game_preview_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/default_specimen_name"
                                android:textAppearance="@style/TextAppearance.App.Title" />

                            <TextView
                                android:id="@+id/game_preview_habitat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/habitat_woodland"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_name_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:hint="@string/game_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/herb_ink" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/game_label_shape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/game_section_shape"
                    android:textAppearance="@style/TextAppearance.App.LabelWide" />

                <com.pocketherbarium.notes.core.ui.TraitChipRowView
                    android:id="@+id/game_trait_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/game_label_colour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/game_section_colour"
                    android:textAppearance="@style/TextAppearance.App.LabelWide" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/game_swatch_sage"
                        android:layout_width="@dimen/swatch_touch"
                        android:layout_height="@dimen/swatch_touch"
                        android:background="@drawable/ripple_secondary"
                        android:clickable="true"
                        android:contentDescription="@string/cd_colour_sage"
                        android:focusable="true">

                        <View
                            android:layout_width="@dimen/swatch_size"
                            android:layout_height="@dimen/swatch_size"
                            android:layout_gravity="center"
                            android:background="@drawable/swatch_sage" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/game_swatch_deep"
                        android:layout_width="@dimen/swatch_touch"
                        android:layout_height="@dimen/swatch_touch"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ripple_secondary"
                        android:clickable="true"
                        android:contentDescription="@string/cd_colour_deep"
                        android:focusable="true">

                        <View
                            android:layout_width="@dimen/swatch_size"
                            android:layout_height="@dimen/swatch_size"
                            android:layout_gravity="center"
                            android:background="@drawable/swatch_deep" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/game_swatch_pale"
                        android:layout_width="@dimen/swatch_touch"
                        android:layout_height="@dimen/swatch_touch"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ripple_secondary"
                        android:clickable="true"
                        android:contentDescription="@string/cd_colour_pale"
                        android:focusable="true">

                        <View
                            android:layout_width="@dimen/swatch_size"
                            android:layout_height="@dimen/swatch_size"
                            android:layout_gravity="center"
                            android:background="@drawable/swatch_pale" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/game_swatch_yellow"
                        android:layout_width="@dimen/swatch_touch"
                        android:layout_height="@dimen/swatch_touch"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ripple_secondary"
                        android:clickable="true"
                        android:contentDescription="@string/cd_colour_yellow"
                        android:focusable="true">

                        <View
                            android:layout_width="@dimen/swatch_size"
                            android:layout_height="@dimen/swatch_size"
                            android:layout_gravity="center"
                            android:background="@drawable/swatch_yellow" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/game_swatch_rust"
                        android:layout_width="@dimen/swatch_touch"
                        android:layout_height="@dimen/swatch_touch"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ripple_secondary"
                        android:clickable="true"
                        android:contentDescription="@string/cd_colour_rust"
                        android:focusable="true">

                        <View
                            android:layout_width="@dimen/swatch_size"
                            android:layout_height="@dimen/swatch_size"
                            android:layout_gravity="center"
                            android:background="@drawable/swatch_rust" />

                    </FrameLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/game_label_habitat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/game_section_habitat"
                    android:textAppearance="@style/TextAppearance.App.LabelWide" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_habitat_windowsill"
                        style="@style/Widget.App.Button.Chip"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="@string/habitat_windowsill" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_habitat_woodland"
                        style="@style/Widget.App.Button.Chip"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/habitat_woodland" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_habitat_pond"
                        style="@style/Widget.App.Button.Chip"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="@string/habitat_pond" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_habitat_herbrow"
                        style="@style/Widget.App.Button.Chip"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/habitat_herbrow" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_care_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:hint="@string/game_care_hint"
                    app:startIconContentDescription="@string/cd_care_icon"
                    app:startIconDrawable="@drawable/ic_watering">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_care_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="2"
                        android:textColor="@color/herb_ink" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_location_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/block_gap"
                    android:hint="@string/game_location_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_location_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textColor="@color/herb_ink" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/game_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/block_gap"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/root_bottom_pad"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/game_facts_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_facts_shape"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/game_fact_shape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/trait_oval"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/herb_ink"
                        android:textSize="13sp" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/hairline"
                    android:layout_height="match_parent"
                    android:background="@color/herb_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_facts_colour"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/game_fact_colour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/colour_sage"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/herb_ink"
                        android:textSize="13sp" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/hairline"
                    android:layout_height="match_parent"
                    android:background="@color/herb_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_facts_spot"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/game_fact_spot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/habitat_woodland"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="@color/herb_ink"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/herb_hairline"
                android:importantForAccessibility="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_cta"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_height"
                android:layout_marginTop="@dimen/block_gap"
                android:text="@string/game_cta"
                app:icon="@drawable/ic_press" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/secondary_height"
                android:layout_marginTop="@dimen/cta_bottom_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_discard"
                    style="@style/Widget.App.Button.Danger"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/btn_discard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_collections"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/btn_collections" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
